{
	email admin@retroscenerebuild.com
}

www.retroscenerebuild.com {
	redir https://retroscenerebuild.com{uri} permanent
}

retroscenerebuild.com {
	root * /srv/site
	encode zstd gzip
	# Leech protection: downloads only via a link from this site
	@leech {
		path /files/*
		not header Referer https://retroscenerebuild.com/*
	}
	error @leech 403
	file_server
	@rsr path *.rsr
	header @rsr Content-Type application/octet-stream
	header @rsr Content-Disposition attachment
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
